    "precheck": [
      {
        "description": "ensure constraint \"class\" does not exist",
        "sql": "SELECT NOT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "class",
          "public",
          "\"public\".\"classes\""
        ]
      }
    ],
    "execute": [
      {
        "description": "add unique constraint \"class\"",
        "sql": "ALTER TABLE \"public\".\"classes\" ADD CONSTRAINT \"class\" UNIQUE (\"class\")"
