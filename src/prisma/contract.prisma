// use prisma-next
// Contrato inferido do banco PostgreSQL e ajustado à convenção do projeto:
// os nomes dos campos espelham exatamente os nomes das colunas (snake_case),
// para que os DTOs de repositório continuem sendo aplicáveis diretamente.

// WARNING: This table has no primary key in the database
model Classes {
  class      String @unique(map: "class")
  quantity   Int?
  guild_name String

  @@map("classes")
}

model CommandHashes {
  command_name String @id(map: "command_hashes_pkey")
  file_hash    String

  @@map("command_hashes")
}

model DiscordEventWarnings {
  message_id String @id(map: "discord_event_warnings_pkey")
  channel_id String
  event_id   String

  @@map("discord_event_warnings")
}

model FeatureFlags {
  guild_id String @id(map: "featureFlags_pkey")
  flags    Jsonb?

  @@map("featureFlags")
}

model Guilds {
  guild_name String  @id(map: "guilds_pkey")
  guild_id   String
  clusters   String?

  @@map("guilds")
}

model Interactions {
  id           Int           @id(map: "interactions_pkey") @default(autoincrement())
  message_id   String
  guild_name   String
  category     String?
  role_name    String?
  user_name    String
  channel_name String
  message      String
  thread_name  String?
  dt           Timestamp(0)? @default(now())

  @@index([message_id], map: "idx_message_id")
  @@map("interactions")
}

model OnlineMembers {
  dt       Timestamp(0) @id(map: "online_members_pkey")
  quantity Int

  @@map("online_members")
}

model Polls {
  id               Int           @id(map: "polls_pkey") @default(autoincrement())
  poll_hash        String?
  guild_name       String
  category         String
  poll_question    String
  response1_text   String
  response1_value  Int
  response2_text   String
  response2_value  Int
  response3_text   String?
  response3_value  Int?
  response4_text   String?
  response4_value  Int?
  response5_text   String?
  response5_value  Int?
  response6_text   String?
  response6_value  Int?
  response7_text   String?
  response7_value  Int?
  response8_text   String?
  response8_value  Int?
  response9_text   String?
  response9_value  Int?
  response10_text  String?
  response10_value Int?
  dt               Timestamp(0)? @default(now())

  @@map("polls")
}

model ZoomMeetings {
  id                         Int          @id(map: "zoom_meetings_pkey") @default(autoincrement())
  title                      String
  department                 String?
  duration_in_minutes        Int
  host_email                 String
  metting_creation_source    String
  metting_group              String?
  created_at                 Timestamp(0)
  started_at                 Timestamp(0)
  ended_at                   Timestamp(0)
  meeting_id                 String
  max_simultaneous_views     Int          @default(0)
  host_name                  String?
  max_entries                Int
  meeting_type               String
  max_unique_views           Int
  place                      String?
  total_participants_minutes Int

  @@map("zoom_meetings")
}
