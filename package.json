        "node": "24.x"
    },
    "lint-staged": {
        "*.ts": "eslint --cache"
    },
    "license": "ISC",
    "dependencies": {
        "@napi-rs/canvas": "^1.0.6",
        "discord.js": "^14.27.0",
        "dotenv": "^17.4.2",
